<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SurvCamApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.SurvCam"
        android:usesCleartextTraffic="true">
        <activity android:name=".activities.LoginActivity" />
        <activity android:name=".activities.SettingsActivity" />
        <activity android:name=".activities.PlaybackActivity"
            android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name=".activities.RecordingDaysActivity" />
        <activity android:name=".activities.RecordingHoursActivity" />
        <activity android:name=".activities.NativePlaybackActivity"
            android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name=".activities.LiveViewActivity"
            android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name=".activities.CameraDetailActivity" />
        <activity android:name=".activities.CameraListActivity" />
        <activity android:name=".activities.ServerSetupActivity" />
        <activity android:name=".activities.NotificationHistoryActivity" />
        <activity android:name=".activities.SnapshotDaysActivity" android:exported="false" />
        <activity android:name=".activities.SnapshotHoursActivity" android:exported="false" />
        <activity android:name=".activities.SnapshotListActivity" android:exported="false" />
        <activity android:name=".activities.SnapshotViewerActivity" android:exported="false" />
        <activity
            android:name=".activities.MultiCameraActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="false" />

        <service
            android:name=".notifications.SurvCamFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".notifications.MuteActionReceiver"
            android:exported="false" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
