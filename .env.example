# Copy this file to .env and change the values before starting the server.
# Generate secrets with: openssl rand -hex 32
SURVCAM_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SURVCAM_ACCESS_TOKEN_EXPIRE_DAYS=30
SURVCAM_OTA_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_24_BYTES
SURVCAM_FIRMWARE_BASE_URL=http://YOUR_SERVER_LAN_IP:8000

# Initial administrator is created interactively with: python create_admin.py
SURVCAM_CONTROL_USERS=YOUR_ADMIN_USERNAME

# Optional notifications: Telegram two-factor login
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Android push notifications; use your own Firebase service account
SURVCAM_FIREBASE_CREDENTIALS=./firebase-service-account.json

# Storage (defaults to backend/data if unset; for an external disk, set mount + UUID)
# SURVCAM_STORAGE_MOUNT=/mnt/survcam-recordings
# SURVCAM_STORAGE_UUID=YOUR_DISK_UUID
SURVCAM_DATA_DIR=./data
SURVCAM_DATABASE_PATH=./data/survcam.db
SURVCAM_TELEMETRY_DB=./data/telemetry.db
SURVCAM_RECORDINGS_ROOT=./data/recordings
SURVCAM_SNAPSHOT_ROOT=./data/thumbnails

# Optional comma-separated camera IDs to suppress from notifications
SURVCAM_IGNORED_CAMERA_NOTIFICATION_IDS=

# Optional motion detector tuning: comma-separated camera_id:value pairs / IDs
SURVCAM_PER_CAMERA_MIN_CHANGED_PIXELS=
SURVCAM_MOTION_BOTTOM_HALF_CAMERA_IDS=
